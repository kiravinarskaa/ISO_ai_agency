# Copy these settings into Railway's Variables panel.
# Keep real values out of Git and out of browser JavaScript.
BOSS_PASSWORD=replace-with-a-long-private-password
SESSION_SECRET=replace-with-at-least-32-random-characters
GOOGLE_SPREADSHEET_ID=your-google-spreadsheet-id
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"..."}
PORT=3000

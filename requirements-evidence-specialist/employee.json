                              "employee.json",
                              "recipes/BROWSER-RECIPES.md",
                              "run/**",
                              "scripts/**",
                              "examples/**",
                              "AEO-PLAYBOOK.md",
                              "standards/PUBLISH-STANDARD.md",
                              "WORK-CYCLE.md",
                              "work-profile.json",

                            "readonly":  true
                        }
                    ],
    "routines":  [
                     {
                         "id":  "build-evidence-register",
                         "days":  "mon-fri",
                         "fire":  "00:01",
                         "window_start":  "00:00",
                         "window_end":  "23:59",
                         "period_key":  "YYYY-MM-DD",
                         "budget":  "30 min",
                         "browser":  "never"
                     }
                 ],
    "files":  {
                  "kit":  [
                              "AGENTS.md",
                              "CAPABILITIES.md",
                              "CHANGELOG.md",
                              "CONTRACT.md",
                              "INSTALL-PROMPT.md",
                              "README.md",
                              "ROLE.md",
                              "VERSION",

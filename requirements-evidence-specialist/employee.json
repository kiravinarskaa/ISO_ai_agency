                                 "paid/**",
                                 "fleet/**",
                                 "drafts/**",
                                 "calendar/**",
                                 "run/*.log",
                                 "recipes/*.json",
                                 "runlog.jsonl",
                                 "*-latest.md",
                                 ".installed.json",
                                 "tracking/**",
                                 "content/**",
                                 "index/**",
                                 "PAUSED",
                                 "schedule-commands.txt",
                                 "progress/**",
                                 "experiments/**",
                                 "handoffs/**",
                                 ".upgrade/**"
                             ]
              },
    "notes":  {
                  "merge":  "SCHEDULE.md carries the shape the kit ships and the days, windows and budgets the member owns. An upgrade reports a changed shape and never rewrites the row values.",
                  "member":  "Everything under member is the business the employee has been running: its evidence, its ledgers, its learned browser flows and its own field repairs. An upgrade that overwrites any of it has destroyed work that exists nowhere else.",
                  "recipes":  "recipes/BROWSER-RECIPES.md ships with the kit. Every recipes/*.json is learned on the member\u0027s own screens by the routine that owns it, so it is member data.",
                  "phase1":  "One ISO readiness demonstration routine active; former routine files retained but inactive."
              }
}
